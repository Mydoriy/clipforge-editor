# ==============================================================================
# ClipForge Desktop Web - Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
#
# NOTE: ClipForge is 100% Client-Side and Local-First.
# All environment variables below are OPTIONAL. The application runs fully
# offline in Guest mode without any backend configuration.
# ==============================================================================

# 1. Supabase Cloud Sync & Authentication (Optional)
# Leave blank to run 100% locally via Dexie IndexedDB in browser.
# To enable Google OAuth and encrypted cloud backup:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Serverless AI Proxy Endpoint (Optional)
# Allows routing LLM / Vision requests through a secure private worker (Cloudflare Worker / Vercel Edge)
# without exposing your API keys directly in client storage.
VITE_SERVERLESS_AI_PROXY_URL=https://ai-proxy.your-domain.workers.dev

# 3. Default AI API Key (Optional)
# If provided, acts as the default key for EditPilot AI and AI Image Generator.
# Recommended: Users configure their own key locally via Settings Modal.
VITE_AI_API_KEY=

# 4. Telemetry & Error Reporting (Optional)
# Strict Zero-Tracking by default. Only enabled when explicitly set to 'true'.
VITE_ENABLE_SENTRY_OPT_IN=false
