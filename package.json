{
  "name": "clipforge-editor",
  "version": "1.0.0",
  "type": "module",
  "description": "ClipForge - 9:16 Vertical Video Editor for TikTok, Reels, Shorts",
  "main": "index.html",
  "bin": {
    "capfx": "./bin/capfx.mjs"
  },
  "scripts": {
    "capfx": "node bin/capfx.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/tests/*.test.mjs",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "maintenance": "node scripts/monthly-maintenance.mjs",
    "generate:licenses": "node scripts/generate-third-party-notices.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky"
  },
  "keywords": [
    "video-editor",
    "tiktok",
    "reels",
    "webcodecs",
    "supabase",
    "vercel"
  ],
  "author": "ClipForge",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vercel": "^65.12.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/supabase-js": "^2.119.0",
    "@types/canvas-confetti": "^1.9.0",
    "@xenova/transformers": "^2.17.2",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "immer": "^11.2.9",
    "konva": "^10.9.1",
    "lucide-react": "^1.70.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
